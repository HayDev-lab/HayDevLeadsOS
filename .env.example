# HAYDEV LEADOS — environment template (v0.19.1)
# Copy to .env and fill in. NEVER commit real secrets — .env is gitignored.
# In demo deployments everything below except DATABASE_URL can stay empty.

# ---- Database (SQLite) ----
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ---- Demo mode ----
# true = public demo: implicit demo session, demo integrations, and the Meta
# connector's Demo provider (ZERO calls to graph.facebook.com, by construction).
LEADOS_DEMO=true

# ---- REAL Meta Lead Ads integration (leave empty in demo mode) ----
# From developers.meta.com → your app → App Settings → Basic.
META_APP_ID=
META_APP_SECRET=
# Graph API version. Default v26.0 (current stable, released 2026-07-29,
# verified 2026-09-18). Pin an older supported version (e.g. v25.0) if needed.
META_GRAPH_API_VERSION=v26.0
# Arbitrary secret string YOU choose — used for the webhook GET hub.challenge
# verification (Meta echoes it back during endpoint verification).
META_WEBHOOK_VERIFY_TOKEN=
# OAuth redirect URI (must match the app's Valid OAuth Redirect URIs exactly):
# https://your-domain/api/v1/integrations/meta/callback
META_REDIRECT_URI=
# 32-byte hex (64 chars) key used to AES-256-GCM-encrypt integration tokens
# at rest. REQUIRED in production (demo/dev derives a fallback key with a warning).
INTEGRATION_ENCRYPTION_KEY=

# ---- Webhook endpoint to configure in the Meta App Dashboard ----
# https://your-domain/api/v1/integrations/meta/webhook
# (verify token = META_WEBHOOK_VERIFY_TOKEN; signature = X-Hub-Signature-256,
#  HMAC-SHA256 of the raw body with META_APP_SECRET)
