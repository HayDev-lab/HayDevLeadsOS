DATABASE_URL=file:/home/z/my-project/db/custom.db
# --- v0.16 WORKER INFRASTRUCTURE ---
# Demo delivery mode: external sends are SIMULATED (spec 99-101). A real
# deployment unsets LEADOS_DEMO and configures providers below instead.
LEADOS_DEMO=true
# Client tick (dev/demo fallback only — the production scheduler is the
# in-process one started via instrumentation.ts; leave unset in production).
NEXT_PUBLIC_DEMO_WORKER_TICK=true
# Production scheduler (on by default; WORKER_SCHEDULER_ENABLED=false to
# delegate to an external cron calling POST /workers/run with the secret).
# WORKER_SCHEDULER_INTERVAL_MS=300000
# WORKERS_SECRET=set-me-in-production
# APP_URL=https://your-leados.example
# --- Real provider credentials (inactive while LEADOS_DEMO=true) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=LeadOS <notify@example>
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Demo QA: 60s scheduler interval (production default stays 5 min when unset).
WORKER_SCHEDULER_INTERVAL_MS=60000
META_APP_SECRET=test-webhook-secret-0123456789abcdef
META_WEBHOOK_VERIFY_TOKEN=test-verify-token-xyz
